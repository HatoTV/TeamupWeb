{
    "version": 2,
    "builds": [
      {
        "src": "dist/teamup-web/**",
        "use": "@vercel/static-build"
      }
    ],
    "routes": [
      {
        "src": "/api/(.*)", 
        "dest": "/api/$1"
      },
      {
        "src": "/[^.]+",
        "dest": "/index.html",
        "status": 200
      }
    ]
  }
  